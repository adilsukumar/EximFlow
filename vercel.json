{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__api_path=/api/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/api/index.py?__api_path=/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
